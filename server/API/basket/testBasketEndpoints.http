

###
// 201: Create basket for user has an empty basket
// add product id 0 with quantity 1, product id 5 with quantity 2
POST http://localhost:3000/user/lucas.bennett/basket HTTP/1.1
Content-Type: application/json

{
  "basket": [[0,1],[5,2]] 
}

###

// 409: Attempt to create basket for user who already has one(Mia)
POST http://localhost:3000/user/mia.anderson/basket HTTP/1.1
Content-Type: application/json

{
  "basket": [[1,1]]
}

###

// 200: Add a product to a specific user's basket
// Add 2 products with id 0 to a user's basket
PUT http://localhost:3000/user/mia.anderson/basket HTTP/1.1
Content-Type: application/json

{
  "product": [0,2] 
}

###

// 404: Attempt to add a product to a non-existing user's basket
PUT http://localhost:3000/user/dummy.user/basket HTTP/1.1
Content-Type: application/json

{
  "product": [0, 2]
}

###

// 200: Remove a product from a specific user's basket
// Remove one product with id 0 from a user's basket
DELETE http://localhost:3000/user/mia.anderson/basket/0 HTTP/1.1

###

// 404: Attempt to remove a product that doesn't exist in the basket
DELETE http://localhost:3000/user/mia.anderson/basket/999 HTTP/1.1

###

// 404: Attempt to remove a product from a non-existing user's basket
DELETE http://localhost:3000/user/dummy.user/basket/0 HTTP/1.1

###
// Returns basket for a single user by username
GET http://localhost:3000/user/mia.anderson/basket HTTP/1.1

###
// Returns 404 since the user does not exist - no basket can be found
GET http://localhost:3000/user/wrong.name/basket HTTP/1.1

###
// Returns an empty basket [] since the user has no items on it
GET http://localhost:3000/user/ethan.diaz/basket HTTP/1.1

